# Copie ce fichier en ".env" et remplis tes identifiants EmailJS (https://www.emailjs.com/)
# Sans ces variables, le formulaire de contact bascule automatiquement
# sur un lien "mailto:" pré-rempli — le site fonctionne donc même sans backend.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
